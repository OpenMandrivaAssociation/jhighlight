Name:		jhighlight
Version:	1.0
Release:	1
Summary:	Embeddable Java syntax highlighter
Group:		Development/Java
License:	CDDL-1.0 OR LGPL-2.1-or-later
URL:		https://jhighlight.dev.java.net/
# Maven Central sources jar com.uwyn:jhighlight:1.0, repacked.
# The four lexer .java files that were generated by an old JFlex are
# not in this archive. The build section runs the system JFlex on the
# .flex files. No jars or class files.
Source0:		%{name}-%{version}.tar.gz

BuildArch:	noarch
BuildRequires:	java-current-devel
BuildRequires:	sysjar
BuildRequires:	jflex

%description
JHighlight 1.0 turns Java, Groovy, C++, XML, HTML, and LZX source
into XHTML. Gradle's build uses com.uwyn:jhighlight for report
highlighting. HighlightFilter is not compiled: it is the only class
that imports javax.servlet, and cooker does not need that adapter.

%prep
%autosetup -n %{name}-%{version} -p1
find . \( -name '*.jar' -o -name '*.class' -o -name '*.so' -o -name '*.node' -o -name '*.wasm' \) -delete

%build
set -eo pipefail
export JAVA_HOME=%{_jvmdir}/java-openjdk
export PATH="$JAVA_HOME/bin:$PATH"
command -v jflex
find com -name '*.java' ! -name HighlightFilter.java > hand.list
find com -name '*.flex' > flex.list
test "$(wc -l < hand.list)" -eq 31
test "$(wc -l < flex.list)" -eq 4
mkdir -p gen/com/uwyn/jhighlight/highlighter
while IFS= read -r flex; do
	jflex -q -d gen/com/uwyn/jhighlight/highlighter "$flex"
done < flex.list
find gen -name '*.java' > gen.list
test "$(wc -l < gen.list)" -eq 4
cat hand.list gen.list > sources.list
mkdir -p classes
javac --release 8 -encoding UTF-8 -Xlint:-options -proc:none \
	-d classes @sources.list
cp -p jhighlight.properties JHIGHLIGHT_VERSION classes/
jar cf jhighlight.jar -C classes .
jar i jhighlight.jar

cat > jhighlight.pom << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.uwyn</groupId>
  <artifactId>jhighlight</artifactId>
  <version>1.0</version>
  <name>JHighlight</name>
  <description>Syntax highlighting library. The servlet filter is not included.</description>
  <url>https://jhighlight.dev.java.net/</url>
  <licenses>
    <license>
      <name>CDDL-1.0 OR LGPL-2.1-or-later</name>
      <url>https://opensource.org/licenses/cddl1</url>
    </license>
  </licenses>
</project>
EOF

%install
set -eo pipefail
sysjar install --buildroot %{buildroot} \
	--artifact jhighlight.pom:jhighlight.jar \
	--file-name jhighlight \
	--filelist .mfiles

%check
set -eo pipefail
export JAVA_HOME=%{_jvmdir}/java-openjdk
export PATH="$JAVA_HOME/bin:$PATH"
JAR=%{buildroot}%{_javadir}/jhighlight.jar
test -s "$JAR"
mkdir -p check
cat > check/Smoke.java << 'EOF'
import com.uwyn.jhighlight.renderer.Renderer;
import com.uwyn.jhighlight.renderer.XhtmlRendererFactory;
public class Smoke {
	public static void main(String[] args) throws Exception {
		Renderer renderer = XhtmlRendererFactory.getRenderer("java");
		String html = renderer.highlight("Hello.java",
			"public class Hello { int x; }\n", "UTF-8", true);
		if (!html.contains("java_keyword") || !html.contains("Hello")) {
			System.out.println(html);
			System.exit(1);
		}
		System.out.println("jh_ok java_keyword Hello");
	}
}
EOF
javac --release 8 -encoding UTF-8 -Xlint:-options -proc:none \
	-cp "$JAR" -d check check/Smoke.java
java -cp "check:$JAR" Smoke > check/out.txt
cat check/out.txt
grep -F -q 'jh_ok java_keyword Hello' check/out.txt

%files -f .mfiles
%license LICENSE
